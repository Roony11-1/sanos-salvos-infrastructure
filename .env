# ─── General ───────────────────────────────────────
RUN_TESTS=false
GENERATE_COVERAGE=false

# ─── Networks ──────────────────────────────────────
NETWORK_NAME=sanos-salvos-network

# ─── Images ─────────────────────────────────────────
POSTGRES_VERSION=postgres:15
MONGO_VERSION=mongo:7
ZOOKEEPER_VERSION=confluentinc/cp-zookeeper:7.4.0
KAFKA_VERSION=confluentinc/cp-kafka:7.4.0
KEYCLOAK_VERSION=quay.io/keycloak/keycloak:25.0.6

# ─── Mascotas DB ────────────────────────────────────
MASCOTAS_DB_NAME=mascotas
MASCOTAS_DB_USER=user
MASCOTAS_DB_PASS=pass
MASCOTAS_DB_HOST_PORT=5431
MASCOTAS_DB_INTERNAL_PORT=5432
MASCOTAS_CONNECTION_STRING=Host=mascotas-db;Port=5432;Database=mascotas;Username=user;Password=pass

# ─── Coincidencias DB ────────────────────────────────
COINCIDENCIAS_DB_NAME=coincidencias
COINCIDENCIAS_DB_USER=admin
COINCIDENCIAS_DB_PASS=admin
COINCIDENCIAS_DB_HOST_PORT=5430
COINCIDENCIAS_DB_INTERNAL_PORT=5432

# ─── Users DB ───────────────────────────────────────
USERS_DB_NAME=users
USERS_DB_USER=user
USERS_DB_PASS=pass
USERS_DB_INTERNAL_PORT=5432

# ─── Message DB (Mongo) ─────────────────────────────
MESSAGE_DB_NAME=messages
MESSAGE_DB_HOST_PORT=27017
MESSAGE_DB_INTERNAL_PORT=27017

# ─── Zookeeper ──────────────────────────────────────
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ─── Kafka ──────────────────────────────────────────
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_PORT=9092
KAFKA_MATCHES_TOPIC=matches-detectados

# ─── Keycloak ───────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_INTERNAL_PORT=8080
KEYCLOAK_REALM=reino-neytan
KC_CLIENT_ID_BACKEND=sanos-backend
KC_CLIENT_SECRET_BACKEND=odioconmialmajavascript1234
KC_CLIENT_ID_LOGIN=sanos-login
KC_CLIENT_SECRET_LOGIN=odioconmialmajavascript1234

# ─── Service Ports (internal) ──────────────────────
MASCOTAS_SERVICE_PORT=8080
COINCIDENCIAS_SERVICE_PORT=8000
NOTIFICATION_SERVICE_PORT=8082
MESSAGE_SERVICE_PORT=8080
USER_SERVICE_PORT=8090
GATEWAY_PORT=8080
FRONTEND_PORT=80
ASTRO_PORT=80

# ─── Host Ports ─────────────────────────────────────
COINCIDENCIAS_HOST_PORT=8090
NOTIFICATION_HOST_PORT=8082
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=80

# ─── Kafka Consumer Groups ─────────────────────────
KAFKA_CONSUMER_GROUP_COINCIDENCIAS=coincidencias-group
KAFKA_CONSUMER_GROUP_NOTIFICATION=notification-group
KAFKA_CONSUMER_GROUP_MASCOTAS=mascotas-service

# ─── Kafka Bootstrap ──────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Kafka Topics ──────────────────────────────────
KAFKA_TOPIC_EVALUAR_COINCIDENCIAS=evaluar-coincidencias
KAFKA_TOPIC_ERRORES_COINCIDENCIAS=errores-coincidencias
KAFKA_TOPIC_NEW_MESSAGES=new-messages

# ─── Kafka Broker ──────────────────────────────────
KAFKA_BROKER=kafka:9092
ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092

# ─── Service Internal URLs ─────────────────────────
COINCIDENCIAS_SERVICE_URL=http://coincidencias-service:8000
MASCOTAS_SERVICE_URL=http://mascotas-service:8080
MESSAGE_SERVICE_URL=http://message-service:8080
USER_SERVICE_URL=http://user-service:8090

# ─── MongoDB ───────────────────────────────────────
MONGODB_CONNECTION_STRING=mongodb://message-db:27017

# ─── Keycloak / JWT URLs ───────────────────────────
JWT_ISSUER_URI=http://keycloak:8080/realms/reino-neytan
JWKS_URI=http://keycloak:8080/realms/reino-neytan/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/reino-neytan/protocol/openid-connect/token
KEYCLOAK_ADMIN_API=http://keycloak:8080/admin/realms/reino-neytan

# ─── Frontend ──────────────────────────────────────
VITE_API_GATEWAY_URL=
